SECURELAYER_ENV=local
SECURELAYER_GATEWAY_PORT=8080

POSTGRES_DB=securelayer
POSTGRES_USER=securelayer
POSTGRES_PASSWORD=change-me-local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

OIDC_ISSUER_URI=https://issuer.example.com
OIDC_AUDIENCE=securelayer-api

TLS_KEYSTORE_PATH=/run/secrets/securelayer-keystore.p12
TLS_KEYSTORE_PASSWORD=change-me
SECURELAYER_TLS_ENABLED=false
